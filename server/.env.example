# 复制为 .env 并按需填写。
# 未配置的可选项会自动禁用对应能力，不影响其他搜索源。

# 可选：启用 LLM Query 改写与结果重排
OPENAI_API_KEY=sk-your-openai-key

# 可选：启用 YouTube 官方搜索
YOUTUBE_API_KEY=your-youtube-api-key

# 可选：启用 Jamendo 音乐搜索
JAMENDO_CLIENT_ID=your-jamendo-client-id

# 可选：启用 Google 网页补充搜索
# 需要同时配置 API Key 和 Programmable Search Engine CX
GOOGLE_SEARCH_API_KEY=your-google-search-api-key
GOOGLE_SEARCH_CX=your-google-search-engine-cx
